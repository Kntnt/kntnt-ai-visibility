# Normalise line endings: text files use LF in the repository.
* text=auto eol=lf

# Keep shell scripts and PHP as LF regardless of platform.
*.sh   text eol=lf
*.php  text eol=lf

# Development-only paths excluded from `git archive` exports, so source
# tarballs stay clean. The release zip does not depend on them:
# bin/build-release-assets limits its export to the runtime keep-list.
# composer.json / composer.lock are deliberately NOT ignored — the build
# exports them to run `composer install --no-dev` and removes them afterwards.
/.github            export-ignore
/docs               export-ignore
/tests              export-ignore
/.gitignore         export-ignore
/.gitattributes     export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml        export-ignore
/patchwork.json     export-ignore
/run-tests.sh       export-ignore
/bin                export-ignore
/CLAUDE.md          export-ignore
/AGENTS.md          export-ignore
